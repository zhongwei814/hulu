{
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/index.py"
    }
  ]
}
